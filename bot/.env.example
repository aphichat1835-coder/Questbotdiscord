DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=
TIMEZONE=Asia/Bangkok
LOG_CHANNEL_ID=
MANAGER_ROLE_ID=

# Local: ./data/quests.db and ./data/backups
# Persistent hosting: /var/data/quests.db and /var/data/backups
DATABASE_PATH=./data/quests.db
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_RETENTION=7

# Required for encrypted Auto Daily token storage; use a long random secret.
RUNNER_TOKEN_SECRET=

# Optional Bearer token for HTTP GET /api/status. The endpoint is disabled when empty.
HEALTH_STATUS_TOKEN=

# Fixed Discord client profile — update the complete set together, then restart the bot.
DISCORD_CLIENT_VERSION=
DISCORD_CHROME_VERSION=
DISCORD_ELECTRON_VERSION=
DISCORD_BUILD_NUMBER=
DISCORD_NATIVE_BUILD_NUMBER=
DISCORD_LOCALE=en-US
DISCORD_TIMEZONE=Asia/Bangkok
