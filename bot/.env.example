# Required — set these six values on Render.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_ID=
RUNNER_TOKEN_SECRET=
LOG_WEBHOOK_URL=

# Optional bot access and output overrides.
TIMEZONE=Asia/Bangkok
LOG_CHANNEL_ID=
MANAGER_ROLE_ID=

# Database path and backup behavior are selected automatically.
# Persistent hosting default: /var/data/quests.db and /var/data/backups
# Local fallback: ./data/quests.db and ./data/backups
# These remain available only when an explicit override is needed.
DATABASE_PATH=
DATABASE_BACKUP_ENABLED=
DATABASE_BACKUP_RETENTION=7

# Optional Bearer token for HTTP GET /api/status. The endpoint is disabled when empty.
HEALTH_STATUS_TOKEN=

# Fixed Discord client profile — optional overrides must be updated as one complete set.
DISCORD_CLIENT_VERSION=
DISCORD_CHROME_VERSION=
DISCORD_ELECTRON_VERSION=
DISCORD_BUILD_NUMBER=
DISCORD_NATIVE_BUILD_NUMBER=
DISCORD_LOCALE=en-US
DISCORD_TIMEZONE=Asia/Bangkok