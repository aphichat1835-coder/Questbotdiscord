{
  "name": "neverdie-quest-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:control": "QUEST_PROCESS_ROLE=control node src/index.js",
    "start:worker": "QUEST_PROCESS_ROLE=worker node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/register-commands.js",
    "test": "node --import ./test/setup-env.js --test",
    "test:mutation-safety": "node scripts/mutation-safety.mjs",
    "check": "find src scripts \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "validate:quest-fixture": "node scripts/validate-quest-fixture.mjs",
    "smoke:quest": "node scripts/smoke-quest-api.mjs",
    "test:coverage": "node --import ./test/setup-env.js --test --experimental-test-coverage --test-coverage-lines=60"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  }
}
